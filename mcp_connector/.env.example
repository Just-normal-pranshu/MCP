# Public HTTPS URL of this service (nginx path prefix included, no trailing slash)
ERP_MCP_PUBLIC_BASE_URL=https://aiagent.zorder.in/erp-mcp

# APIFabric base URL: the connector calls POST {URL}/access_token
ERP_MCP_APIFABRIC_URL=https://CHANGE_ME_APIFABRIC_HOST
# 1 = admin login profile
ERP_MCP_LOGIN_MODE=1

# ERP Data API base URL (wherever the Data API is deployed)
ERP_MCP_DATA_API_URL=http://127.0.0.1:8820
ERP_MCP_DATA_API_TIMEOUT_SECONDS=150

# SQLite file for OAuth clients/tokens and ERP sessions (keep outside the code folder, back it up)
ERP_MCP_DB_PATH=/var/lib/erp-mcp/erp_mcp.sqlite3
# Fernet key that encrypts ERP tokens at rest. In production put it in /etc/erp-mcp/secret.env
# (root:root 600), NOT here, so backups of this folder and the SQLite file never contain it:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ERP_MCP_ENCRYPTION_KEY=

# OAuth redirect URIs allowed at client registration (exact match). Claude's callbacks only.
ERP_MCP_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
# Allow http://localhost callbacks (Claude Code / mcp-remote). Local testing only.
ERP_MCP_ALLOW_LOCALHOST_REDIRECTS=false
# Per-account login throttle
ERP_MCP_ACCOUNT_MAX_FAILURES=5
ERP_MCP_ACCOUNT_LOCKOUT_MINUTES=15

ERP_MCP_ACCESS_TOKEN_TTL_SECONDS=3600
ERP_MCP_REFRESH_TOKEN_TTL_DAYS=30
ERP_MCP_ERP_TOKEN_ASSUMED_VALIDITY_DAYS=7
ERP_MCP_MAX_LOGIN_ATTEMPTS=5

# Host headers accepted by /mcp (comma separated)
ERP_MCP_ALLOWED_HOSTS=aiagent.zorder.in
ERP_MCP_LOG_LEVEL=INFO

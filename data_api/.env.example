# sql = run the stored procedures (production); fixture = sample Excel files (local dev only)
DATA_API_DATA_SOURCE=sql
# Development modes (fixture data, static resolver) refuse to run unless this is true. Never in production.
DATA_API_ALLOW_DEV_MODES=false
DATA_API_FIXTURE_DIR=../dev/fixtures

# appfabric = ask the ERP connection API (production); static = instances.json (dev/testing)
DATA_API_RESOLVER=appfabric
DATA_API_INSTANCES_FILE=instances.json

# ERP connection-details API (Token + Instance_Id -> server, database, user, password)
DATA_API_CONN_API_URL=https://CHANGE_ME/<senior connection API path>
DATA_API_CONN_API_METHOD=GET
DATA_API_CONN_API_KEY_HEADER=X-Internal-Key
DATA_API_CONN_API_KEY=
DATA_API_CONN_API_TIMEOUT_SECONDS=15
# Exact field names in the connection API response. Leave blank to auto-detect.
# Senior's API returns ServerIP / SqlUsrId / SqlPwd (auto-detected); set the database field explicitly:
DATA_API_CONN_FIELD_SERVER=
DATA_API_CONN_FIELD_DATABASE=devicedid
DATA_API_CONN_FIELD_USER=
DATA_API_CONN_FIELD_PASSWORD=
# Reuse a resolved connection for this long per token+company (seconds)
DATA_API_CONN_CACHE_SECONDS=600
# SQL connection encryption. Keep true in production.
DATA_API_SQL_ENCRYPT=true
# Verify SQL Server TLS certificates (false = verify). Set true only for servers with self-signed
# certificates, knowing it allows impersonation on the network path.
DATA_API_SQL_TRUST_SERVER_CERTIFICATE=false
# Interactive API docs at /docs (keep off in production)
DATA_API_ENABLE_DOCS=false

DATA_API_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DATA_API_SQL_TIMEOUT_SECONDS=120
DATA_API_CACHE_TTL_SECONDS=300
DATA_API_MAX_RANGE_DAYS=731

# Browser apps allowed to call the API directly, comma separated (e.g. https://apps.zorder.in)
DATA_API_CORS_ORIGINS=
